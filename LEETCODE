QUESTION - 66. Plus One
ANS :

class Solution {
    public int[] plusOne(int[] digits) {
        for(int i = digits.length - 1; i >= 0; i--) {
            if(digits[i] < 9) {
                digits[i]++;
                return digits;
            }
            digits[i] = 0;
        }
        int[] ans = new int[digits.length + 1];
        ans[0] = 1;
        return ans;
    }
}


QUESTION - 4061. Minimum Queen Moves to Reach Target

ANS 

class Solution {
    public int minQueenMoves(int[] source, int[] target) {
        if (source[0] == target[0] && source[1] == target[1]) {
            return 0;
        }
        else {
            if (source[0] == target[0] || source[1] == target[1]) {
                return 1 ;
            }
            else if (source[0] - target[0] == source[1] - target[1] ||
                     source[0] - target[0] == target[1] - source[1]) {
                return 1;
            }
            else {
                return 2;
            }
        }
    }
}
